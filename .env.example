# ==============================================================================
# LOUGARA B2B — FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier en .env.local (développement) ou dans les variables Vercel/Render
# ==============================================================================

# --- 1. Base de données & Supabase ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/lougara?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-publique-anon"
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role"
NEXT_PUBLIC_APP_URL="https://lougara.com"

# --- 2. Stripe (Mode Test : pk_test_ / sk_test_ | Mode Prod : pk_live_ / sk_live_) ---
NEXT_PUBLIC_STRIPE_ENABLED="true"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_votre_cle_publique_stripe"
STRIPE_SECRET_KEY="sk_test_votre_cle_secrete_stripe"
STRIPE_WEBHOOK_SECRET="whsec_votre_secret_webhook_stripe"

# --- 3. Virement Bancaire Manuel (RIB Officiel Lougara / Qonto) ---
BANK_TRANSFER_HOLDER="Lougara (EI - CHAMPAGNE Christelle / Mimonga)"
BANK_TRANSFER_IBAN="FR76 1695 8000 0112 9657 5872 333"
BANK_TRANSFER_BIC="QNTOFRP1XXX"
BANK_TRANSFER_PARTNER_SWIFT="TRWIBEB3XXX"
BANK_TRANSFER_BANK_NAME="Qonto SA, 18 rue de Navarin, 75009 Paris, France"

# --- 4. Mentions Légales pour les Factures PDF Séquentielles ---
LEGAL_COMPANY_NAME="Lougara"
LEGAL_HOLDER_NAME="EI - CHAMPAGNE Christelle / Mimonga"
LEGAL_ADDRESS="30 BIS RUE du Vieil Abreuvoir, 78100 Saint-Germain-en-Laye, France"
LEGAL_SIRET="Votre numéro SIRET"
LEGAL_VAT_NOTICE="TVA non applicable, art. 293 B du CGI"

# --- 5. Mobile Money & Paiements Africains (Optionnel : s'active automatiquement si renseigné) ---
# CinetPay (Sénégal, Côte d'Ivoire, Cameroun, Mali, Burkina Faso, Togo, Bénin, Guinée, RDC)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

# Flutterwave (Nigéria, Ghana, Kenya, Afrique du Sud, Cameroun, Sénégal, International)
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# PayDunya (Sénégal, Côte d'Ivoire, Bénin, Burkina Faso, Togo, Mali — Wave, Orange Money, Free Money)
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MODE="test"

# --- 6. Emails Transactionnels (Resend HTTP API — Mode simulation console automatique si vide) ---
RESEND_API_KEY=""
EMAIL_FROM="Lougara Facturation <facturation@lougara.com>"
