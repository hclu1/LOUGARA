datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  COMMERCIAL_REGISTER // Kbis / RCCM
  TAX_ID_CERTIFICATE  // NINEA / NIF
  IDENTITY_DOCUMENT   // Passeport / CNI Gérant
  UTILITY_BILL        // Justificatif de domicile pro
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model User {
  id             String          @id @default(cuid())
  supabaseUid    String          @unique
  email          String          @unique
  role           UserRole        @default(BUYER)
  firstName      String?
  lastName       String?
  avatarUrl      String?
  company        CompanyProfile?
  sentMessages   Message[]       @relation("SentMessages")
  conversations  Conversation[]  @relation("BuyerConversations")
  contactCredits ContactCredit[]
  contactRequests ContactRequest[] @relation("BuyerContactRequests")
  billingEvents  BillingEvent[]
  paymentOrders  PaymentOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CompanyProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  country            String
  city               String
  registrationNumber String?
  sector             String               // Ex: Cosmétique, Textile, Agroalimentaire
  description        String?
  website            String?
  phone              String?
  logoUrl            String?
  isPublished        Boolean              @default(false)
  verificationStatus VerificationStatus   @default(NOT_SUBMITTED)
  verificationNotes  String?
  verifiedAt         DateTime?
  documents          VerificationDocument[]
  products           Product[]
  receivedConvs      Conversation[]       @relation("SupplierConversations")
  receivedContactRequests ContactRequest[] @relation("CompanyContactRequests")
  subscription       UserSubscription?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model VerificationDocument {
  id                String         @id @default(cuid())
  companyId         String
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType      DocumentType
  filePath          String         // Chemin dans le bucket Supabase sécurisé
  fileName          String
  fileSize          Int
  mimeType          String
  status            DocumentStatus @default(PENDING)
  notes             String?
  issuingAuthority  String?        // Greffe, Tribunal de Commerce, Direction Impôts
  signatureVerified Boolean        @default(false) // Contrôle du sceau / signature officielle du greffe
  locationVerified  Boolean        @default(false) // Validation de l'adresse physique du siège social
  uploadedAt        DateTime       @default(now())
}

model Product {
  id            String         @id @default(cuid())
  companyId     String
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  slug          String         @unique
  description   String
  category      String
  priceMin      Decimal?
  priceMax      Decimal?
  currency      String         @default("EUR")
  moq           Int            @default(1)
  unit          String         @default("pièce")
  originCountry String
  images        String[]
  isPublished   Boolean        @default(true)
  conversations Conversation[]
  contactRequests ContactRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Conversation {
  id         String         @id @default(cuid())
  buyerId    String
  buyer      User           @relation("BuyerConversations", fields: [buyerId], references: [id])
  supplierId String
  supplier   CompanyProfile @relation("SupplierConversations", fields: [supplierId], references: [id])
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  subject    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model SubscriptionPlan {
  id                  String             @id @default(cuid())
  code                String             @unique // FREE, STANDARD, PREMIUM, VIP
  name                String
  description         String?
  priceMonthly        Decimal            @default(0)
  currency            String             @default("EUR")
  stripePriceId       String?            // Identifiant Stripe Price une fois l'inscription effectuée
  maxProducts         Int                @default(5) // -1 pour illimité
  maxContactsPerMonth Int                @default(5) // -1 pour illimité
  hasBadge            Boolean            @default(false)
  hasPriorityMatching Boolean            @default(false)
  hasAnalytics        Boolean            @default(false)
  isPublicCatalogInverted Boolean        @default(false)
  isPublished         Boolean            @default(true)
  subscriptions       UserSubscription[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model UserSubscription {
  id                   String             @id @default(cuid())
  companyId            String             @unique
  company              CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model PlatformSettings {
  id                   String   @id @default("default")
  isStripeEnabled      Boolean  @default(false) // Interrupteur Super Admin
  allowFreeCatalogLimit Int     @default(5)     // Quota gratuit par défaut
  currency             String   @default("EUR")
  contactEmail         String   @default("contact@lougara.com")
  updatedAt            DateTime @updatedAt
}

model SubscriptionPlanV2 {
  id                   String      @id @default(cuid())
  code                 String      @unique // SUPPLIER_FREE, SUPPLIER_ESSENTIAL, etc.
  target               String      // SUPPLIER ou BUYER
  nameFr               String
  nameEn               String
  descriptionFr        String?
  descriptionEn        String?
  priceMonthlyEur      Decimal     @default(0)
  priceAnnualEur       Decimal     @default(0)
  maxProducts          Int         @default(4)
  maxContactsPerMonth  Int         @default(0)
  relationValidityDays Int         @default(30)
  hasVerifiedBadge     Boolean     @default(false)
  hasPriorityRanking   Boolean     @default(false)
  isActive             Boolean     @default(true)
  displayOrder         Int         @default(0)
  prices               PlanPrice[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model PlanPrice {
  id           String             @id @default(cuid())
  planId       String
  plan         SubscriptionPlanV2 @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency     String             // EUR, USD, XOF, XAF, GNF, MAD, NGN
  priceMonthly Decimal
  priceAnnual  Decimal
  pricingMode  String             @default("FIXED_LOCAL")
  isActive     Boolean            @default(true)
  updatedAt    DateTime           @updatedAt

  @@unique([planId, currency])
}

model ContactCredit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int       @default(0)
  currency  String    @default("EUR")
  source    String    @default("PURCHASE")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ContactRequest {
  id              String         @id @default(cuid())
  buyerId         String
  buyer           User           @relation("BuyerContactRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  companyId       String
  company         CompanyProfile @relation("CompanyContactRequests", fields: [companyId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  requestType     String         @default("QUOTE")
  message         String
  preferredLocale String         @default("fr")
  status          String         @default("SENT")
  creditsDeducted Int            @default(1)
  validUntil      DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model BillingEvent {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType             String   // PAYMENT, RENEWAL, REFUND, CREDIT_CONSUMED
  amount                Decimal
  currency              String
  amountEurEquivalent   Decimal?
  provider              String   // STRIPE, ORANGE_MONEY, WAVE, MTN_MOMO
  providerTransactionId String?
  metadataJson          String?
  createdAt             DateTime @default(now())
}

model SystemMaintenance {
  id                  String   @id @default("global")
  isMaintenanceActive Boolean  @default(false)
  lastActiveVersion   String   @default("0.15.3")
  message             String?  @default("Maintenance technique Lougara")
  updatedAt           DateTime @updatedAt
}

enum PaymentOrderStatus {
  PENDING
  WAITING_TRANSFER
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentBillingCycle {
  MONTHLY
  ANNUAL
  ONE_TIME
}

model PaymentOrder {
  id                   String              @id @default(cuid())
  reference            String              @unique // Ex: LOU-2026-4829
  userId               String?
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail        String
  customerName         String?
  companyId            String?
  companyName          String?
  countryCode          String              @default("FR")
  planCode             String              // SUPPLIER_ESSENTIAL, BUYER_PRO, CREDIT_PACK_5...
  planName             String
  billingCycle         PaymentBillingCycle @default(MONTHLY)
  amount               Decimal
  currency             String              @default("EUR")
  provider             String              // STRIPE, BANK_TRANSFER, CINETPAY, FLUTTERWAVE, PAYDUNYA
  paymentMethodType    String?             // card, sepa_debit, bank_transfer, orange_money, wave, mtn_momo...
  status               PaymentOrderStatus  @default(PENDING)
  providerPaymentId    String?             // ID PaymentIntent, Subscription, ou transaction Mobile Money
  providerClientSecret String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  metadataJson         String?
  paidAt               DateTime?
  refundedAt           DateTime?
  validatedByEmail     String?             // Email admin ayant validé un virement bancaire
  invoice              Invoice?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([provider])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   // STRIPE, CINETPAY, FLUTTERWAVE, PAYDUNYA
  eventId     String   @unique
  eventType   String
  status      String   @default("PROCESSED")
  payload     String?
  processedAt DateTime @default(now())
}

model Invoice {
  id              String       @id @default(cuid())
  invoiceNumber   String       @unique // Ex: FAC-2026-0001
  sequenceNumber  Int
  year            Int
  orderId         String       @unique
  order           PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerEmail   String
  customerName    String
  customerCompany String?
  customerAddress String?
  amountHt        Decimal
  taxRate         Decimal      @default(0)
  taxAmount       Decimal      @default(0)
  amountTtc       Decimal
  currency        String       @default("EUR")
  issuedAt        DateTime     @default(now())

  @@unique([year, sequenceNumber])
}




